// Esquema de simplicityCurr — currículo K-12 alineado al DEPR.

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Autenticación ---

model Teacher {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  password    String
  role        String       @default("teacher") // "teacher" | "admin"
  createdAt   DateTime     @default(now())
  classes     Class[]
  units       Unit[]
  toolOutputs ToolOutput[]
}

model Class {
  id          String   @id @default(cuid())
  name        String
  description String?
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId   String
  subject     Subject  @relation(fields: [subjectId], references: [id])
  subjectId   String
  grade       Grade    @relation(fields: [gradeId], references: [id])
  gradeId     String
  createdAt   DateTime @default(now())
  units       Unit[]
}

// --- Catálogo base ---

model Subject {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  standards Standard[]
  units     Unit[]
  classes   Class[]
}

model Grade {
  id        String     @id @default(cuid())
  label     String     @unique // "K", "1" ... "12"
  order     Int        @unique
  standards Standard[]
  units     Unit[]
  classes   Class[]
}

// --- Estándares y expectativas del DEPR ---

model Standard {
  id           String        @id @default(cuid())
  subject      Subject       @relation(fields: [subjectId], references: [id])
  subjectId    String
  grade        Grade         @relation(fields: [gradeId], references: [id])
  gradeId      String
  code         String
  description  String
  expectations Expectation[]

  @@unique([subjectId, gradeId, code])
  @@index([subjectId, gradeId])
}

model Expectation {
  id          String              @id @default(cuid())
  standard    Standard            @relation(fields: [standardId], references: [id], onDelete: Cascade)
  standardId  String
  code        String
  description String
  indicators  Json?
  units       UnitExpectation[]
  lessons     LessonExpectation[]

  @@unique([standardId, code])
}

// --- Mapa curricular ---

model Unit {
  id           String            @id @default(cuid())
  code         String
  teacher      Teacher           @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId    String
  class        Class?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  classId      String?
  subject      Subject           @relation(fields: [subjectId], references: [id])
  subjectId    String
  grade        Grade             @relation(fields: [gradeId], references: [id])
  gradeId      String
  title        String
  description  String?
  timeframe    String?
  order        Int               @default(0)
  expectations UnitExpectation[]
  lessons      Lesson[]
  workbooks    Workbook[]
  toolOutputs  ToolOutput[]

  @@unique([teacherId, code])
  @@index([subjectId, gradeId])
  @@index([teacherId])
}

model UnitExpectation {
  unit          Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId        String
  expectation   Expectation @relation(fields: [expectationId], references: [id], onDelete: Cascade)
  expectationId String

  @@id([unitId, expectationId])
}

model Lesson {
  id              String              @id @default(cuid())
  unit            Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  unitId          String
  title           String
  objectives      String?
  durationMinutes Int?
  content         Json?
  format          String?
  weekNumber      Int?
  order           Int                 @default(0)
  expectations    LessonExpectation[]
  workbooks       Workbook[]
  toolOutputs     ToolOutput[]
}

model LessonExpectation {
  lesson        Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId      String
  expectation   Expectation @relation(fields: [expectationId], references: [id], onDelete: Cascade)
  expectationId String

  @@id([lessonId, expectationId])
}

// --- Herramientas para maestros ---

model ToolOutput {
  id        String   @id @default(cuid())
  type      String   // "rubrica" | "quiz" | "boletin" | "comunicacion" | "nivelador" | "preguntas"
  title     String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  lessonId  String?
  unit      Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  unitId    String?
  content   Json
  createdAt DateTime @default(now())

  @@index([teacherId])
}

// --- Cuadernos ---

model Workbook {
  id        String   @id @default(cuid())
  title     String
  status    String   @default("draft")
  pages     Json?
  unit      Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  unitId    String?
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  lessonId  String?
  createdAt DateTime @default(now())
}
