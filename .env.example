# PostgreSQL — en VPS: postgresql://simplicity:<password>@localhost:5432/simplicitycurr
DATABASE_URL="postgresql://user:password@localhost:5432/simplicitycurr"

# Genera con: openssl rand -hex 32
SESSION_SECRET="<reemplaza-con-openssl-rand-hex-32>"

# Rota en console.anthropic.com si fue expuesta
ANTHROPIC_API_KEY="sk-ant-..."

# Modelo de generación (opcional — default: claude-haiku-4-5-20251001)
# GENERATION_MODEL=claude-haiku-4-5-20251001

# Límite diario de generaciones por maestro (opcional — default: 50)
# AI_DAILY_LIMIT=50

NODE_ENV=production
